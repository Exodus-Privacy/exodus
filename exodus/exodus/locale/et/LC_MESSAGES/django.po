#: men_customization/templates/base/home.html:19
#: web/templates/base/home.html:24
msgid "εxodus analyzes Android applications in order to <b>list the embedded trackers.</b>"
msgstr "εxodus analüüsib Androidi rakenduse ja tuvastab <b>sinna lõimitud jälitajad.</b>"

#: men_customization/templates/base/home.html:21
#: web/templates/base/home.html:26
msgid "A tracker is a piece of software <b>meant to collect data about you or your usages.</b> So, εxodus reports tell you what are the ingredients of the cake."
msgstr "Jälitaja on tarkvarakomponent, <b>mille eesmärgiks on koguda teavet sinu ja sinu nutiseadme kasutuse kohta</b>. Seega εxodus aitab sul mõista, mis koogi pealispinna maasikate ja vahukoore all tegelikult peidus on."

#: men_customization/templates/base/home.html:23
#: web/templates/base/home.html:28
msgid "εxodus does not decompile applications, its analysis method is legal."
msgstr "εxodus ei pöördkompileeri rakendusi, meie analüüsimeetod on seaduskuulekas."

#: men_customization/templates/base/home.html:30
#: web/templates/base/home.html:35
msgid "What is a tracker? And a permission? Are there any alternatives to protect yourself?"
msgstr "Mis on jälitaja? Aga mis on rakenduse õigused? Kas mul on valikuid enda privaatsuse kaitsmiseks?"

#: men_customization/templates/base/home.html:38
#: web/templates/base/home.html:43
