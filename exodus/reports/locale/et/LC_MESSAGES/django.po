#: reports/templates/report_details.html:165
msgid "The icon &nbsp;<img src=\"/static/img/danger.svg\">&nbsp; indicates a 'Dangerous' or 'Special' level according to <a target=\"_blank\" rel=\"noreferrer\" href=\"https://developer.android.com/guide/topics/permissions/overview\">Google's protection levels</a>."
msgstr "Ikoon &nbsp;<img src=\"/static/img/danger.svg\">&nbsp; märgib, et tegemist on <a target=\"_blank\" rel=\"noreferrer\" href=\"https://developer.android.com/guide/topics/permissions/overview\">Google'i turvareeglite</a> järgi „Ohtlik“ või „Spetsiaalne“ tasemel õigustega."

