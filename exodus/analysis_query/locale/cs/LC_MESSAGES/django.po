msgstr "Probíhá analýza..."

#: analysis_query/templates/query_wait.html:30
msgid "See the report"
msgstr "Zobrazit zprávu"

#: analysis_query/templates/query_wait.html:34
msgid "Will refresh automatically every 10 seconds."
msgstr "Obnovuje se automaticky každých 10 sekund."

#: analysis_query/templates/query_wait.html:68
msgid "Analysis done!"
msgstr "Analýza dokončena!"

