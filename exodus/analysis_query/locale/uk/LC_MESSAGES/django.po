#: analysis_query/models.py:39
#, python-format
msgid "%s is not a valid application handle"
msgstr "%s не є коректним описувачем програми"

#: analysis_query/models.py:47
msgid "The application '{}' cannot be found"
msgstr "Застосунок '{}' не можливо знайти"

#: analysis_query/models.py:54
msgid "This application is being analyzed."
msgstr "Цей застосунок аналізується."

#: analysis_query/models.py:59
msgid "Too much pending requests, please retry later"
msgstr "Забагато незавершених запитів, спробуйте повторити пізніше"

#: analysis_query/models.py:67
msgid "Unsupported file extension"
msgstr "Непідтримувані розширення файлів"

#: analysis_query/templates/queries_list.html:42
msgid "You need to be registered"
msgstr "Вам потрібно зареєструватися"

#: analysis_query/templates/query_submit.html:9
#: analysis_query/templates/query_upload.html:9
msgid "New analysis"
msgstr "Нові аналізи"

#: analysis_query/templates/query_submit.html:21
msgid "It is currently impossible to submit new analysis. Sorry for the inconvenience!"
msgstr "На даний час неможливо надсилати нові аналізи. Вибачте за незручність!"

#: analysis_query/templates/query_submit.html:36
msgid "URL of the application"
msgstr "URL застосунку"

#: analysis_query/templates/query_submit.html:45
msgid "Source:"
msgstr "Джерело:"

#: analysis_query/templates/query_submit.html:55
msgid "Free applications only. Works also with the application handle."
msgstr "Лише безкоштовні програми. Працює також з обробкою програми."

#: analysis_query/templates/query_submit.html:67
#: analysis_query/templates/query_upload.html:50
msgid "Perform analysis"
msgstr "Виконати аналіз"

#: analysis_query/templates/query_submit.html:73
msgid "I prefer to upload an application"
msgstr "Я волію завантажувати додаток"

#: analysis_query/templates/query_submit.html:80
#: analysis_query/templates/query_upload.html:57
msgid "The analysis could take a long time, you will be automatically redirected to the report."
msgstr "Аналіз може зайняти багато часу, ви будете автоматично перенаправлені на звіт."

#: analysis_query/templates/query_submit.html:94
#: analysis_query/templates/query_upload.html:70
#: analysis_query/templates/query_wait.html:39
msgid "is a non-profit organization which provides this service for free."
msgstr "це некомерційна організація, яка забезпечує цей сервіс безкоштовно."

#: analysis_query/templates/query_submit.html:96
#: analysis_query/templates/query_upload.html:72
#: analysis_query/templates/query_wait.html:41
msgid "Help us!"
msgstr "Допоможіть нам!"

#: analysis_query/templates/query_submit.html:132
msgid "This application has already been analyzed!"
msgstr "Цей застосунок вже проаналізовано!"

#: analysis_query/templates/query_submit.html:138
msgid "analyzed on"
msgstr "проаналізовано"

#: analysis_query/templates/query_submit.html:138
msgid "Go to the latest report"
msgstr "Перейти до останнього звіту"

#: analysis_query/templates/query_submit.html:142
msgid "If you think εxodus has not yet analyzed the latest version of this application, feel free to submit the analysis."
msgstr "Якщо ви думаєте, що εxodus ще не проаналізував останню версію цієї програми, то не соромтеся подати аналіз."

#: analysis_query/templates/query_upload.html:32
msgid "Upload an application"
msgstr "Вивантажити застосунок"

#: analysis_query/templates/query_upload.html:36
msgid "Browse file"
msgstr "Переглянути файл"

#: analysis_query/templates/query_upload.html:42
msgid "Only works with APK files."
msgstr "Працює лише з файлами APK."

#: analysis_query/templates/query_wait.html:9
msgid "Analysis in progress..."
msgstr "Іде аналіз..."

#: analysis_query/templates/query_wait.html:24
msgid "See the report"
msgstr "Переглянути звіт"

#: analysis_query/templates/query_wait.html:28
msgid "Will refresh automatically every 10 seconds."
msgstr "Автоматично оновлюватиме кожні 10 секунд."

#: analysis_query/templates/query_wait.html:64
msgid "Analysis done!"
msgstr "Аналізи готові!"

#: analysis_query/views.py:34 analysis_query/views.py:62
msgid "Your request will be handled soon"
msgstr "Ваш запит буде оброблено найближчим часом"

#: analysis_query/views.py:76 analysis_query/views.py:84
msgid "AnalysisRequest does not exist"
msgstr "AnalysRequest не існує"

