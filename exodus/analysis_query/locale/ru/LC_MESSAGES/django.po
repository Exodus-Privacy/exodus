msgid "You need to be registered"
msgstr "Требуется регистрация"

#: analysis_query/templates/query_submit.html:9
#: analysis_query/templates/query_upload.html:9
msgid "New analysis"
msgstr "Новый анализ"

#: analysis_query/templates/query_submit.html:21
msgid "It is currently impossible to submit new analysis. Sorry for the inconvenience!"
msgstr "В данный момент невозможно отправить новый анализ. Приносим извинения за неудобства!"

#: analysis_query/templates/query_submit.html:36
msgid "URL of the application"
msgstr "URL приложения"

#: analysis_query/templates/query_submit.html:45
msgid "Source:"
msgstr "Источник:"

